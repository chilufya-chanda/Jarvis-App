<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to record your voice -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed to call Groq + Edge TTS over the internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed to keep listening for the wake word with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed to show the floating orb on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Needed to ask you to exempt Jarvis from battery-saver killing it -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Using a built-in Android system icon here on purpose. A custom
        @mipmap/ic_launcher was never generated for this project, and
        pointing to it without the actual image files would fail the
        build with a "resource not found" error. Swap this for a real
        app icon whenever you want — Android Studio's
        Right-click app folder > New > Image Asset makes that a 2-minute
        job — but it's not required for the app to build and run.
    -->
    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Jarvis"
        android:theme="@style/Theme.Jarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
